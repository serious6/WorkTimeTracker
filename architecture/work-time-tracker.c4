specification {
  element person
  element system
  element container
  relationship uses
}

model {
  user = person 'User'
  application = system 'WorkTimeTracker' {
    frontend = container 'React UI' {
      technology 'React, TypeScript, Tailwind, shadcn/ui'
    }
    backend = container 'Desktop backend' {
      technology 'Tauri 2, Rust commands'
      description 'Validates input and returns structured AppError kinds'
    }
    database = container 'Local database' {
      technology 'Postgres, Drizzle schema'
      description 'Local Postgres database accessed through a small connection pool'
    }

    session = container 'Sessions' {
      technology 'Rust, Argon2id password hashes'
      description 'Sessions kept by opaque id, with idle timeout and login lockout'
    }

    frontend -> backend 'Invokes commands with its session id'
    backend -> session 'Resolves the user of that session id'
    backend -> database 'Reads and writes bounded windows of that user, verifies credentials'
    database -> session 'Keeps the login attempt counters across restarts'
  }

  user -> application 'Signs in and tracks work time'
}

views {
  view overview {
    title 'WorkTimeTracker overview'
    include *
  }
}
