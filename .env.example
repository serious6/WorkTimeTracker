# Copy to `.env` to configure the database backend used by the Tauri app,
# the `podman compose` / `docker compose` stack, and `drizzle.config.ts`.
# All variables are optional; the defaults below reproduce today's behaviour
# (an embedded SQLite file in the app's data directory).

# Which store implementation to use: "sqlite" (default) or "postgres".
WTT_DB_BACKEND=sqlite

# Only used when WTT_DB_BACKEND=postgres. Must match the `db` service in
# compose.yaml when using the bundled Postgres container. Format:
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://worktimetracker:worktimetracker@localhost:5432/worktimetracker

# Optional: override where the SQLite database file is stored. Defaults to
# `<app-data-dir>/work-time-tracker.sqlite` when unset.
#WTT_SQLITE_PATH=

# Used by the `db` service in compose.yaml (podman/docker compose --profile postgres).
POSTGRES_DB=worktimetracker
POSTGRES_USER=worktimetracker
POSTGRES_PASSWORD=worktimetracker
