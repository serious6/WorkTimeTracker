# Copy to `.env` to configure the Postgres database used by the Tauri app,
# the `podman compose` / `docker compose` stack, and `drizzle.config.ts`.

# Must match the `db` service in compose.yaml when using the bundled Postgres
# container. Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://worktimetracker:worktimetracker@localhost:5432/worktimetracker

# Used by the `db` service in compose.yaml.
POSTGRES_DB=worktimetracker
POSTGRES_USER=worktimetracker
POSTGRES_PASSWORD=worktimetracker
