# Copy to `.env` to configure the Postgres database used by the Tauri app,
# the `podman compose` / `docker compose` stack, and `drizzle.config.ts`.

# Required. Set this to the bundled database connection URL, using the same
# local-only password assigned to POSTGRES_PASSWORD below.
# Host-native Tauri connects through the loopback-only published port.
# Compose builds the development container's equivalent URL with host `db`.
# Format: postgresql://<user>:<password>@localhost:<port>/<database>
DATABASE_URL=

# Required by the development container. This uses host `db` and the password
# must be percent-encoded for use in a PostgreSQL URL.
# Format: postgresql://<user>:<percent-encoded-password>@db:<port>/<database>
POSTGRES_CONTAINER_URL=

# Used by the `db` service in compose.yaml.
POSTGRES_DB=worktimetracker
POSTGRES_USER=worktimetracker
POSTGRES_PASSWORD=

# --- Deployment mode ---------------------------------------------------------

# `development` (the default) or `production`. Development, the test suites and
# CI stay on the local database above and reject every other TCP host.
# `production` is set for a deployed build only: it may reach a remote database,
# but only over TLS with the certificate chain and the host name verified.
WORK_TIME_TRACKER_ENV=

# --- Production database (deployment only, injected from secrets) ------------
#
# Leave every value below empty in a checkout. They are configuration of a
# deployment, never credentials of the repository, and the release workflow
# provides them from the secrets of the protected `production` environment.
#
# `DATABASE_URL` above wins when it is set. Otherwise the connection is
# assembled from these parts as
# postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=verify-full
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=

# Path to the PEM certificate authority the remote server is verified against.
# Required for a remote connection; the certificate store of the machine is
# never trusted, and there is no way to disable the verification.
SUPABASE_DB_ROOT_CERT=

# Set to `true` for the deliberate migration step only. A production process
# otherwise verifies the applied migrations instead of applying them.
WORK_TIME_TRACKER_DB_MIGRATE=
