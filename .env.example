# Copy to `.env` to configure the Postgres database used by the Tauri app,
# the `podman compose` / `docker compose` stack, and `drizzle.config.ts`.

# Required. Set this to the bundled database connection URL, using the same
# local-only password assigned to POSTGRES_PASSWORD below.
# Host-native Tauri connects through the loopback-only published port.
# Compose builds the development container's equivalent URL with host `db`.
# Format: postgresql://<user>:<password>@localhost:<port>/<database>
DATABASE_URL=

# Required by the development container. This uses host `db` and the password
# must be percent-encoded for use in a PostgreSQL URL.
# Format: postgresql://<user>:<percent-encoded-password>@db:<port>/<database>
POSTGRES_CONTAINER_URL=

# Used by the `db` service in compose.yaml.
POSTGRES_DB=worktimetracker
POSTGRES_USER=worktimetracker
POSTGRES_PASSWORD=
