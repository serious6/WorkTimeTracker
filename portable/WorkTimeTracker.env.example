# Configuration of a portable installation of WorkTimeTracker.
#
# Copy this file next to the application and rename it to
# `WorkTimeTracker.env`:
#
#   Windows: beside `WorkTimeTracker.exe`
#   macOS:   beside `WorkTimeTracker.app`, not inside the bundle, so it
#            survives replacing the application
#
# A portable installation needs a remote database: it cannot install or run a
# local Postgres. Every setting has the spelling of `.env.example`, and a value
# that the process environment already carries wins over this file, so a
# managed deployment can still override it.
#
# Restrict the file to its owner before starting the application: on macOS with
# `chmod 600 WorkTimeTracker.env`, and on Windows by removing every other
# account from the permissions of the file. The application refuses to start on
# a file that another account may reach, and it writes the file back readable by
# the current account alone once it has taken the secrets out of it.
#
# On the first start the two secrets below are moved into the credential store
# of this user account - the Windows Credential Manager, which protects them
# with DPAPI, and the macOS Keychain - and this file keeps only the marker
# `stored-in-credential-store` in their place. Delete the file to forget the
# connection; the next start removes the stored secrets as well.

# Required for a portable installation. A remote database is only reached in
# production mode, and only over TLS with the certificate chain and the host
# name verified.
WORK_TIME_TRACKER_ENV=production

# The complete connection string, including `sslmode=verify-full`. It wins over
# the parts below. Secret: it is moved into the credential store.
DATABASE_URL=

# The parts the connection string is assembled from when `DATABASE_URL` is
# empty. `SUPABASE_DB_PASSWORD` is secret and is moved into the credential
# store; the others stay readable in this file.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=

# The PEM certificate authority the server is verified against. Required for a
# remote connection; there is no setting that relaxes the verification. A
# relative path is resolved against the folder of the application, so the
# authority can travel with the portable folder.
SUPABASE_DB_ROOT_CERT=database-ca.pem
