# syntax=docker/dockerfile:1
# Reproducible Linux release build of the Tauri desktop application.
#
#   podman build -f Containerfile.build -o type=local,dest=./release .
#   docker build -f Containerfile.build -o type=local,dest=./release .
#
# A remote client, such as Podman on Windows or macOS, rejects `--output`. Copy the installers
# out of the build stage instead:
#
#   podman build -f Containerfile.build --target builder -t worktimetracker-release .
#   podman create --name worktimetracker-release worktimetracker-release
#   podman cp worktimetracker-release:/artifacts ./release
#   podman rm worktimetracker-release
#
# The result is not a runnable server image: `Containerfile` provides the development
# environment, this file produces the installers that the `Release` workflow attaches to a
# GitHub release. Only Linux bundles are built; Windows and macOS installers require their
# own operating system.
#
# Base images are pinned by digest so that a rebuild is reproducible and a tag cannot be
# repointed at different content; Dependabot's `docker` ecosystem raises the updates.
ARG NODE_IMAGE=docker.io/library/node:26-bookworm-slim@sha256:27f5e13512830beb5d9a574108daa6701a0a0b91528aeaf1ee84ecdcddaeeaae
ARG RUST_IMAGE=docker.io/library/rust:1.98-bookworm@sha256:4e4a7e7939c17991ab35f2b8c2e67593980f771d28f6b1254b1850f860fd0c7f

# The toolchain is copied from the official Rust image instead of piping https://sh.rustup.rs
# into a shell, which executes unverified remote code and pins nothing.
FROM ${RUST_IMAGE} AS rust

FROM ${NODE_IMAGE} AS builder

# Comma-separated Tauri bundle targets, for example "deb" or "deb,rpm,appimage".
ARG TAURI_BUNDLES=deb,rpm,appimage

ENV CARGO_TERM_COLOR=always \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false
# appimagetool cannot mount a FUSE filesystem inside an unprivileged container.
ENV APPIMAGE_EXTRACT_AND_RUN=1

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    desktop-file-utils \
    file \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libssl-dev \
    libwebkit2gtk-4.1-dev \
    patchelf \
    pkg-config \
    wget \
  && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:${PATH}

COPY --from=rust --chown=node:node /usr/local/rustup /usr/local/rustup
COPY --from=rust --chown=node:node /usr/local/cargo /usr/local/cargo
# The Rust image leaves both trees world-writable, which would let any build step replace the
# compiler for the steps that follow.
RUN chmod -R go-w /usr/local/rustup /usr/local/cargo \
  && install -d -o node -g node /usr/local/cargo/registry /workspace /artifacts

WORKDIR /workspace
# The build itself compiles untrusted third-party code (npm packages and crates) and must not
# do so as root.
USER node

COPY --chown=node:node package.json package-lock.json ./
# `--ignore-scripts` stops install-time lifecycle scripts of any transitive dependency from
# executing arbitrary code during the build.
RUN npm ci --prefer-offline --ignore-scripts

COPY --chown=node:node . .

# `npm run tauri build` runs `npm run build`, which verifies src/data/licenses.json first.
RUN npm run tauri build -- --bundles "${TAURI_BUNDLES}"

RUN find src-tauri/target/release/bundle -type f \
    \( -name '*.AppImage' -o -name '*.deb' -o -name '*.rpm' \) \
    -exec cp {} /artifacts/ \; \
  && [ -n "$(ls -A /artifacts)" ] || { echo 'No bundles were produced.' >&2; exit 1; }

# Default target: the installers only, so `--output` writes a clean directory.
FROM scratch AS artifacts
COPY --from=builder /artifacts/ /
