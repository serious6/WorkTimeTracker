# syntax=docker/dockerfile:1.26@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
# Containerized Linux release build of the Tauri desktop application.
#
#   podman build -f Containerfile.build -o type=local,dest=./release .
#   docker build -f Containerfile.build -o type=local,dest=./release .
#
# A remote client, such as Podman on Windows or macOS, rejects `--output`. Copy the installers
# out of the build stage instead:
#
#   podman build -f Containerfile.build --target builder -t worktimetracker-release .
#   podman create --name worktimetracker-release worktimetracker-release
#   podman cp worktimetracker-release:/artifacts ./release
#   podman rm worktimetracker-release
#
# The result is not a runnable server image: `Containerfile` provides the development
# environment, this file produces the installers that the `Release` workflow attaches to a
# GitHub release. Only Linux bundles are built; Windows and macOS installers require their
# own operating system.
#
# The Dockerfile frontend and both base images are pinned by digest, so a tag cannot be
# repointed at different content. The `apt-get install` below is not snapshot-pinned, so the
# Debian packages of an uncached rebuild can differ: the build is repeatable and pinned, not
# bit-for-bit reproducible, and it does not recreate the artifacts of the `Release` workflow.
# The image digests are those of the multi-architecture index, so amd64 and arm64 hosts both
# build natively, and they stay in `FROM`, which is the only place Dependabot's `docker`
# ecosystem discovers them.

# The toolchain is copied from the official Rust image instead of piping https://sh.rustup.rs
# into a shell, which executes unverified remote code and pins nothing.
FROM docker.io/library/rust:1.98-bookworm@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922 AS rust

FROM docker.io/library/node:26-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e AS builder

# Comma-separated Tauri bundle targets, for example "deb" or "deb,rpm,appimage".
ARG TAURI_BUNDLES=deb,rpm,appimage

ENV CARGO_TERM_COLOR=always \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false
# appimagetool cannot mount a FUSE filesystem inside an unprivileged container.
ENV APPIMAGE_EXTRACT_AND_RUN=1

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    desktop-file-utils \
    file \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libssl-dev \
    libwebkit2gtk-4.1-dev \
    patchelf \
    pkg-config \
    wget \
  && rm -rf /var/lib/apt/lists/*

# `CARGO_HOME` is the only writable part of the toolchain and lives in the home directory of
# `node`; the compiler itself stays outside it.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/home/node/.cargo \
    PATH=/usr/local/cargo/bin:${PATH}

COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo
# The Rust image leaves both trees world-writable, which would let any build step replace the
# compiler for the steps that follow. They stay root-owned and read-only for `node`.
RUN chmod -R go-w /usr/local/rustup /usr/local/cargo \
  && install -d -o node -g node /home/node/.cargo /home/node/.cargo/registry \
    /workspace /artifacts

WORKDIR /workspace
# The build itself compiles untrusted third-party code (npm packages and crates) and must not
# do so as root.
USER node

COPY --chown=node:node package.json package-lock.json ./
# `--ignore-scripts` stops install-time lifecycle scripts of any transitive dependency from
# executing arbitrary code during the build.
RUN npm ci --prefer-offline --ignore-scripts

COPY --chown=node:node . .

# `npm run tauri build` runs `npm run build`, which verifies src/data/licenses.json first.
RUN npm run tauri build -- --bundles "${TAURI_BUNDLES}"

RUN find src-tauri/target/release/bundle -type f \
    \( -name '*.AppImage' -o -name '*.deb' -o -name '*.rpm' \) \
    -exec cp {} /artifacts/ \; \
  && [ -n "$(ls -A /artifacts)" ] || { echo 'No bundles were produced.' >&2; exit 1; }

# Default target: the installers only, so `--output` writes a clean directory.
FROM scratch AS artifacts
COPY --from=builder /artifacts/ /
